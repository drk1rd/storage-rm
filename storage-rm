#!/usr/bin/env bash
# storage-rm — find and clear regenerable dev/app junk on macOS.
# Works with the stock macOS bash (3.2): no associative arrays, no mapfile.

set -uo pipefail

VERSION="0.1.0"
LIB="$HOME/Library"
CACHES="$LIB/Caches"
TMP="${TMPDIR:-/tmp}"; TMP=${TMP%/}
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/storage-rm/config"
LABEL="com.storage-rm.clean"
PLIST="$LIB/LaunchAgents/$LABEL.plist"
LOGFILE="$LIB/Logs/storage-rm.log"

DEFAULT_CATS="docker xcode gradle npm pnpm yarn bun brew pip cocoapods cargo go react-native app-caches claude"
OPTIN_CATS="maven xcode-archives ios-simulators android-avd node-modules build-dirs trash"
ALL_CATS="$DEFAULT_CATS $OPTIN_CATS"

# Options (config file first, then CLI flags override)
CMD="scan"
SELECTED=""
SKIP=""
ASSUME_YES=false
DRY=false
FORCE=false
JSON=false
NOTIFY=false
DAYS=30
ROOTS=""
KEEP_GRADLE=2
FAILED=0

if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  B=$'\e[1m' D=$'\e[2m' R=$'\e[31m' G=$'\e[32m' Y=$'\e[33m' C=$'\e[36m' N=$'\e[0m'
else
  B="" D="" R="" G="" Y="" C="" N=""
fi

say()  { printf '%s\n' "$*"; }
info() { printf '%s==>%s %s\n' "$C" "$N" "$*"; }
warn() { printf '%s!%s %s\n' "$Y" "$N" "$*" >&2; }
die()  { printf '%serror:%s %s\n' "$R" "$N" "$*" >&2; exit 1; }
has()  { command -v "$1" >/dev/null 2>&1; }

usage() {
  cat <<EOF
${B}storage-rm${N} $VERSION — clear regenerable dev/app junk on macOS

${B}Usage${N}
  storage-rm [scan]              Show how much each category would free (default, deletes nothing)
  storage-rm clean               Clear the default categories (asks first)
  storage-rm big [N]             List the N largest folders in your home (default 25)
  storage-rm list                Describe every category
  storage-rm schedule FREQ [HH:MM]  Auto-clean via launchd: daily, weekly (Sun) or monthly (1st)
  storage-rm schedule off        Remove the schedule
  storage-rm schedule            Show the schedule and recent log

${B}Options${N}
  -o, --only a,b       Only these categories (can include opt-in ones)
  -s, --skip a,b       Skip these categories
  -a, --all            Include opt-in categories
  -y, --yes            Don't ask for confirmation
  -n, --dry-run        Show what clean would remove without removing it
  -f, --force          Also clear caches of apps that are currently running
      --json           Machine-readable scan output
      --notify         Show a macOS notification when clean finishes
      --days N         node-modules/build-dirs: only projects untouched for N days (default $DAYS)
      --roots a:b      node-modules/build-dirs: folders to search
                       (default ~/Documents:~/Developer:~/code:~/Projects:~/dev:~/src)
      --keep-gradle N  gradle: keep the N newest wrapper distributions (default $KEEP_GRADLE)
  -h, --help           Show this help
  -v, --version        Show version

${B}Config${N}
  $CONFIG  (KEY=value lines; CLI flags win)
  ONLY=  SKIP=app-caches  DAYS=45  ROOTS=~/work:~/Documents  KEEP_GRADLE=2  FORCE=false

${B}Examples${N}
  storage-rm                          # scan
  storage-rm clean -y                 # clear all default categories
  storage-rm clean -o docker,xcode    # just those two
  storage-rm clean -o node-modules,build-dirs --days 60 -n
  storage-rm schedule weekly 21:00
EOF
}

describe() {
  case $1 in
    docker)         echo "Docker build cache + dangling images (containers and volumes kept)" ;;
    xcode)          echo "Xcode DerivedData, older iOS DeviceSupport, simulator caches, unavailable simulators" ;;
    gradle)         echo "Gradle caches, daemon logs, old wrapper distributions" ;;
    npm)            echo "npm cache and npx cache" ;;
    pnpm)           echo "pnpm content store" ;;
    yarn)           echo "Yarn cache" ;;
    bun)            echo "Bun install cache" ;;
    brew)           echo "Homebrew download cache and old versions" ;;
    pip)            echo "pip / poetry caches" ;;
    cocoapods)      echo "CocoaPods cache" ;;
    cargo)          echo "Cargo registry downloads and git checkouts" ;;
    go)             echo "Go build cache and module cache" ;;
    react-native)   echo "Metro / haste-map caches in \$TMPDIR" ;;
    app-caches)     echo "App caches: Spotify, browsers, VS Code, Cursor, Slack, Discord, Electron, …" ;;
    claude)         echo "Claude desktop simulator builds" ;;
    maven)          echo "Maven local repository (~/.m2/repository)" ;;
    xcode-archives) echo "Xcode Archives — you lose dSYMs for old releases" ;;
    ios-simulators) echo "Erase all iOS simulator contents (devices are kept, apps/data wiped)" ;;
    android-avd)    echo "Android emulators (AVDs) and SDK system images" ;;
    node-modules)   echo "node_modules in projects untouched for --days" ;;
    build-dirs)     echo "Build output in stale projects: Pods, android/build, .next, .expo, target, …" ;;
    trash)          echo "Empty the Trash" ;;
  esac
}

is_default() { case " $DEFAULT_CATS " in *" $1 "*) return 0 ;; esac; return 1; }
valid_cat()  { case " $ALL_CATS " in *" $1 "*) return 0 ;; esac; return 1; }

# ---------- sizes ----------

# KB -> human
human() { awk -v k="${1:-0}" 'BEGIN{
  split("K M G T",u," "); i=1; while (k>=1024 && i<4) { k/=1024; i++ }
  if (i==1) printf "%dK", k; else printf "%.1f%s", k, u[i] }'; }

# Sum du -sk over newline-separated paths on stdin
kb_of_paths() {
  local total=0 p s
  while IFS= read -r p; do
    [[ -n $p && -e $p ]] || continue
    s=$(du -sk "$p" 2>/dev/null | cut -f1)
    total=$((total + ${s:-0}))
  done
  echo "$total"
}

# "35.5GB" / "2.1 MB (5%)" -> KB, summed over lines on stdin
docker_to_kb() {
  awk '{
    if (match($0, /[0-9.]+ ?[kKMGT]?B/)) {
      s = substr($0, RSTART, RLENGTH); gsub(/ /, "", s)
      n = s + 0; u = s; gsub(/[0-9.]/, "", u)
      m = (u=="B") ? 1/1024 : (u=="kB"||u=="KB") ? 1 : (u=="MB") ? 1024 : (u=="GB") ? 1048576 : (u=="TB") ? 1073741824 : 0
      t += n * m
    }
  } END { printf "%d\n", t }'
}

avail_kb() {
  local vol=/System/Volumes/Data
  [[ -d $vol ]] || vol=/
  df -k "$vol" | awk 'NR==2{print $4}'
}

# ---------- removal ----------

rm_path() {
  local p=$1
  [[ -n $p ]] || return 0
  case $p in
    "$HOME"/?*|"$TMP"/?*) ;;
    *) warn "refusing to remove path outside home/TMPDIR: $p"; FAILED=1; return 0 ;;
  esac
  case $p in
    "$LIB"|"$CACHES"|"$LIB/Application Support"|"$HOME/Documents"|"$HOME/Desktop")
      warn "refusing to remove $p"; FAILED=1; return 0 ;;
  esac
  [[ -e $p || -L $p ]] || return 0

  if $DRY; then say "  ${D}would remove${N} $p"; return 0; fi

  rm -rf "$p" 2>/dev/null
  if [[ -e $p ]]; then
    # Read-only or locked files (Go module cache, cached .app bundles, …)
    chflags -R nouchg "$p" 2>/dev/null
    chmod -R u+w "$p" 2>/dev/null
    rm -rf "$p" 2>/dev/null
  fi
  if [[ -e $p ]]; then
    warn "could not fully remove $p — macOS may be protecting it; delete it from Finder or give your terminal Full Disk Access / App Management"
    FAILED=1
  fi
}

rm_paths() { local p; while IFS= read -r p; do rm_path "$p"; done; }

run() {
  if $DRY; then say "  ${D}would run${N} $*"; return 0; fi
  "$@" >/dev/null 2>&1 || warn "command failed: $*"
}

existing() { local p; for p in "$@"; do [[ -e $p ]] && echo "$p"; done; return 0; }

# ---------- categories ----------
# Each category has paths_<name> (what du measures and what gets removed),
# optionally extra_<name> (commands to run first) and size_<name> (custom sizing).

docker_ready() { has docker && docker info >/dev/null 2>&1; }

size_docker() {
  docker_ready || { echo 0; return; }
  {
    docker system df --format '{{.Type}}|{{.Reclaimable}}' 2>/dev/null | awk -F'|' '$1=="Build Cache"{print $2}'
    docker images -f dangling=true --format '{{.Size}}' 2>/dev/null
  } | docker_to_kb
}
paths_docker() { :; }
extra_docker() {
  docker_ready || { warn "docker isn't running — skipping"; return; }
  run docker builder prune -af
  run docker image prune -f
}

# Keep the most recently used DeviceSupport folder per device model
old_device_support() {
  local dir="$LIB/Developer/Xcode/iOS DeviceSupport" seen="|" d model
  [[ -d $dir ]] || return 0
  while IFS= read -r d; do
    [[ -n $d ]] || continue
    model=${d%% *}
    case $seen in
      *"|$model|"*) echo "$dir/$d" ;;
      *) seen="$seen$model|" ;;
    esac
  done < <(ls -t "$dir" 2>/dev/null)
}
paths_xcode() {
  existing "$LIB/Developer/Xcode/DerivedData" "$LIB/Developer/CoreSimulator/Caches" "$CACHES/com.apple.dt.Xcode"
  old_device_support
}
extra_xcode() { has xcrun && run xcrun simctl delete unavailable; }

old_gradle_dists() {
  local dir="$HOME/.gradle/wrapper/dists"
  [[ -d $dir ]] || return 0
  local d
  for d in "$dir"/gradle-*; do [[ -d $d ]] && echo "${d##*/}"; done \
    | sed -E 's/^gradle-([^-]+)-.*/\1 &/' \
    | sort -t. -k1,1nr -k2,2nr -k3,3nr | awk '{print $2}' \
    | tail -n +$((KEEP_GRADLE + 1)) | sed "s|^|$dir/|"
}
paths_gradle() { existing "$HOME/.gradle/caches" "$HOME/.gradle/daemon"; old_gradle_dists; }
extra_gradle() { $DRY || pkill -f GradleDaemon 2>/dev/null; true; }

paths_npm()       { existing "$HOME/.npm/_cacache" "$HOME/.npm/_npx"; }
paths_pnpm()      { existing "$LIB/pnpm/store" "$CACHES/pnpm"; }
paths_yarn()      { existing "$CACHES/Yarn" "$HOME/.yarn/berry/cache"; }
paths_bun()       { existing "$HOME/.bun/install/cache"; }
paths_pip()       { existing "$CACHES/pip" "$CACHES/pypoetry"; }
paths_cocoapods() { existing "$CACHES/CocoaPods"; }
paths_cargo()     { existing "$HOME/.cargo/registry/cache" "$HOME/.cargo/registry/src" "$HOME/.cargo/git/checkouts"; }
paths_claude()    { existing "$LIB/Application Support/Claude/simulator-builds"; }
paths_maven()     { existing "$HOME/.m2/repository"; }
paths_xcode_archives() { existing "$LIB/Developer/Xcode/Archives"; }

paths_go() {
  local mod=""
  has go && mod=$(go env GOMODCACHE 2>/dev/null)
  existing "$CACHES/go-build" "${mod:-$HOME/go/pkg/mod}"
}

paths_react_native() {
  local f
  for f in "$TMP"/metro-* "$TMP"/haste-map-* "$TMP"/react-native-packager-cache-*; do
    [[ -e $f ]] && echo "$f"
  done
  return 0
}

paths_brew() { has brew && brew --cache 2>/dev/null; return 0; }
extra_brew() { has brew && run brew cleanup -s --prune=all; return 0; }

size_ios_simulators() { existing "$LIB/Developer/CoreSimulator/Devices" | kb_of_paths; }
paths_ios_simulators() { :; }
extra_ios_simulators() {
  has xcrun || return 0
  run xcrun simctl shutdown all
  run xcrun simctl erase all
}

# path under ~/Library | app bundle name that owns it (empty = no running check)
APP_CACHES="Caches/com.spotify.client|Spotify
Caches/Firefox|Firefox
Caches/BraveSoftware|Brave Browser
Caches/Google|Google Chrome
Caches/com.microsoft.edgemac|Microsoft Edge
Caches/ms-playwright|
Caches/electron|
Caches/electron-builder|
Caches/dotslash|
Caches/termius-updater|
Caches/com.epicgames.EpicGamesLauncher|Epic Games Launcher
Caches/Steam|Steam
Caches/node-gyp|
Caches/typescript|
Caches/com.microsoft.VSCode.ShipIt|
Caches/com.todesktop.230313mzl4w4u92.ShipIt|
Application Support/Code/Cache|Visual Studio Code
Application Support/Code/CachedData|Visual Studio Code
Application Support/Code/CachedExtensionVSIXs|Visual Studio Code
Application Support/Code/Code Cache|Visual Studio Code
Application Support/Cursor/Cache|Cursor
Application Support/Cursor/CachedData|Cursor
Application Support/Cursor/Code Cache|Cursor
Application Support/Slack/Cache|Slack
Application Support/Slack/Code Cache|Slack
Application Support/Slack/Service Worker/CacheStorage|Slack
Application Support/discord/Cache|Discord
Application Support/discord/Code Cache|Discord"

app_running() { pgrep -f "/$1.app/Contents/MacOS/" >/dev/null 2>&1; }

paths_app_caches() {
  local rel app warned="|"
  while IFS='|' read -r rel app; do
    [[ -e $LIB/$rel ]] || continue
    if [[ -n $app ]] && ! $FORCE && app_running "$app"; then
      if [[ $CMD == clean && -z ${SIZING:-} && $warned != *"|$app|"* ]]; then
        warn "$app is running — skipping its cache (quit it or use --force)"
        warned="$warned$app|"
      fi
      continue
    fi
    echo "$LIB/$rel"
  done <<<"$APP_CACHES"
}

paths_android_avd() {
  local f
  for f in "$HOME/.android/avd"/*.avd "$HOME/.android/avd"/*.ini; do [[ -e $f ]] && echo "$f"; done
  existing "$LIB/Android/sdk/system-images"
}

paths_trash() {
  if ! ls "$HOME/.Trash" >/dev/null 2>&1; then
    [[ $CMD == clean && -z ${SIZING:-} ]] && warn "can't read ~/.Trash — give your terminal Full Disk Access, or empty it from Finder"
    return 0
  fi
  find "$HOME/.Trash" -mindepth 1 -maxdepth 1 2>/dev/null
}

# ---------- stale project detection ----------

search_roots() {
  local r list=${ROOTS:-"$HOME/Documents:$HOME/Developer:$HOME/code:$HOME/Projects:$HOME/dev:$HOME/src"}
  local IFS=:
  for r in $list; do
    # shellcheck disable=SC2088 # literal ~ from config/CLI is expanded here
    r=${r/#\~/$HOME}
    [[ -d $r ]] && echo "$r"
  done
}

# Nearest ancestor (up to the search root) that is a git repo, else $1
project_root() {
  local d=$1 stop=$2
  while [[ $d == "$stop"/* || $d == "$stop" ]]; do
    [[ -e $d/.git ]] && { echo "$d"; return; }
    [[ $d == "$stop" ]] && break
    d=${d%/*}
  done
  echo "$1"
}

STALE_YES="|" STALE_NO="|"
# True if no source file in the project changed within --days
is_stale() {
  local p=$1 recent
  [[ $STALE_YES == *"|$p|"* ]] && return 0
  [[ $STALE_NO == *"|$p|"* ]] && return 1
  recent=$(find "$p" -maxdepth 4 \( -name node_modules -o -name .git -o -name Pods -o -name build \
    -o -name .next -o -name .expo -o -name .turbo -o -name .gradle -o -name target \) -prune \
    -o -type f -mtime "-$DAYS" -print 2>/dev/null | head -1)
  if [[ -z $recent ]]; then STALE_YES="$STALE_YES$p|"; return 0; fi
  STALE_NO="$STALE_NO$p|"; return 1
}

paths_node_modules() {
  local root nm
  while IFS= read -r root; do
    while IFS= read -r nm; do
      is_stale "$(project_root "${nm%/node_modules}" "$root")" && echo "$nm"
    done < <(find "$root" -maxdepth 6 -type d -name node_modules -prune 2>/dev/null)
  done < <(search_roots)
}

# Is this a regenerable build dir (vs. e.g. a source folder called "build")?
is_build_dir() {
  local d=$1 parent=${1%/*}
  case ${d##*/} in
    Pods)    [[ -e $parent/Podfile ]] ;;
    build)   [[ -e $parent/build.gradle || -e $parent/build.gradle.kts || ${parent##*/} == ios ]] ;;
    .gradle) [[ -e $parent/gradlew || -e $parent/settings.gradle || -e $parent/settings.gradle.kts ]] ;;
    target)  [[ -e $parent/Cargo.toml ]] ;;
    *)       return 0 ;;
  esac
}

paths_build_dirs() {
  local root d
  while IFS= read -r root; do
    while IFS= read -r d; do
      is_build_dir "$d" || continue
      is_stale "$(project_root "${d%/*}" "$root")" && echo "$d"
    done < <(find "$root" -maxdepth 7 \( -name node_modules -o -name .git \) -prune -o -type d \( \
      -name .next -o -name .expo -o -name .turbo -o -name .parcel-cache -o -name .svelte-kit \
      -o -name .nuxt -o -name .angular -o -name .cxx -o -name Pods -o -name build \
      -o -name .gradle -o -name target \) -print -prune 2>/dev/null)
  done < <(search_roots)
}

# ---------- dispatch ----------

fn_of() { echo "${1//-/_}"; }

cat_size() {
  # SIZING silences "skipping" warnings while measuring
  # shellcheck disable=SC2034
  local f SIZING=1; f=$(fn_of "$1")
  if declare -F "size_$f" >/dev/null; then "size_$f"; else "paths_$f" | kb_of_paths; fi
}

clean_cat() {
  local f; f=$(fn_of "$1")
  if declare -F "extra_$f" >/dev/null; then "extra_$f"; fi
  "paths_$f" | rm_paths
}

selected_cats() {
  local base=$DEFAULT_CATS c out=""
  [[ $CMD == scan ]] && base=$ALL_CATS
  [[ -n $SELECTED ]] && base=${SELECTED//,/ }
  for c in $base; do
    case ",$SKIP," in *",$c,"*) continue ;; esac
    out="$out $c"
  done
  echo "$out"
}

# ---------- commands ----------

cmd_list() {
  local c
  say "${B}Default${N}"
  for c in $DEFAULT_CATS; do printf '  %s%-15s%s %s\n' "$B" "$c" "$N" "$(describe "$c")"; done
  say "${B}Opt-in${N} (use -o name or --all)"
  for c in $OPTIN_CATS; do printf '  %s%-15s%s %s\n' "$B" "$c" "$N" "$(describe "$c")"; done
}

print_row() {
  local size=- dim=$D
  [[ $2 == 0 ]] || { size=$(human "$2"); dim=""; }
  printf '  %-15s %s%8s%s  %s%s%s\n' "$1" "$dim" "$size" "$N" "$D" "$(describe "$1")" "$N"
}

cmd_scan() {
  local c kb total=0 opt=0 opt_header=false first=true
  if $JSON; then
    printf '{"categories":['
    for c in $(selected_cats); do
      kb=$(cat_size "$c")
      is_default "$c" && total=$((total + kb))
      $first || printf ','; first=false
      printf '{"name":"%s","kb":%d,"default":%s}' "$c" "$kb" "$(is_default "$c" && echo true || echo false)"
    done
    printf '],"default_total_kb":%d,"available_kb":%d}\n' "$total" "$(avail_kb)"
    return
  fi

  info "Scanning (nothing is deleted)…"
  printf '\n  %s%-15s %8s  %s%s\n' "$B" "CATEGORY" "SIZE" "WHAT" "$N"
  for c in $(selected_cats); do
    kb=$(cat_size "$c")
    if is_default "$c"; then
      total=$((total + kb))
    else
      opt=$((opt + kb))
      if ! $opt_header; then say "  ${Y}opt-in${N}"; opt_header=true; fi
    fi
    print_row "$c" "$kb"
  done
  say ""
  say "  ${B}clean${N} would free about ${G}$(human "$total")${N} — $(human "$(avail_kb)") available now"
  (( opt > 0 )) && say "  opt-in categories hold another ${Y}$(human "$opt")${N} (use -o name or --all)"
  say ""
  say "  Run ${B}storage-rm clean${N} to clear, or ${B}storage-rm clean -n${N} to preview paths."
}

notify() {
  $NOTIFY || return 0
  osascript -e "display notification \"$1\" with title \"storage-rm\"" >/dev/null 2>&1 || true
}

cmd_clean() {
  local cats c kb total=0 before after freed
  cats=$(selected_cats)
  [[ -n ${cats// /} ]] || die "nothing selected"
  [[ -t 1 ]] || say "--- storage-rm clean $(date '+%Y-%m-%d %H:%M')"

  info "Planned cleanup:"
  for c in $cats; do
    kb=$(cat_size "$c"); total=$((total + kb))
    print_row "$c" "$kb"
  done
  say "  ${B}total ≈ $(human "$total")${N}"
  say ""

  if ! $DRY && ! $ASSUME_YES; then
    [[ -t 0 ]] || die "not a terminal — pass -y to confirm"
    printf 'Proceed? [y/N] '
    read -r ans
    case $ans in y|Y|yes|YES) ;; *) say "Aborted."; exit 0 ;; esac
  fi

  before=$(avail_kb)
  for c in $cats; do
    info "$c"
    clean_cat "$c"
  done
  after=$(avail_kb)
  freed=$((after > before ? after - before : 0))

  say ""
  if $DRY; then
    say "Dry run — nothing was removed."
  else
    say "${G}Freed $(human "$freed")${N} — $(human "$after") available now."
    (( FAILED )) && warn "some items couldn't be removed (see above)"
    notify "Freed $(human "$freed") — $(human "$after") available"
  fi
}

cmd_big() {
  local n=${1:-25}
  [[ $n =~ ^[0-9]+$ ]] || die "big takes a number"
  info "Largest folders in your home (this can take a minute)…"
  {
    du -sk "$HOME"/* "$HOME"/.[!.]* 2>/dev/null
    du -sk "$LIB"/* "$LIB/Application Support"/* "$CACHES"/* "$LIB/Developer"/* 2>/dev/null
  } | grep -v -e "	$LIB\$" -e "	$LIB/Application Support\$" -e "	$CACHES\$" -e "	$LIB/Developer\$" \
    | sort -rn | head -n "$n" \
    | while IFS=$'\t' read -r kb p; do printf '  %8s  %s\n' "$(human "$kb")" "${p/#$HOME/~}"; done
}

self_path() {
  local src=$0
  [[ $src == */* ]] || src=$(command -v "$src")
  echo "$(cd "$(dirname "$src")" && pwd)/$(basename "$src")"
}

cmd_schedule() {
  local freq=${1:-status} at=${2:-10:00} hour minute interval uid
  uid=$(id -u)
  case $freq in
    status)
      if [[ ! -f $PLIST ]]; then say "No schedule. Set one with: storage-rm schedule weekly"; return; fi
      say "Schedule: $(sed -n 's/.*<!-- schedule: \(.*\) -->.*/\1/p' "$PLIST")"
      say "Agent:    $PLIST"
      if launchctl print "gui/$uid/$LABEL" >/dev/null 2>&1; then say "State:    loaded"; else say "State:    ${Y}not loaded${N}"; fi
      if [[ -f $LOGFILE ]]; then say "Log:      $LOGFILE"; say ""; tail -n 12 "$LOGFILE"; fi
      return ;;
    off)
      launchctl bootout "gui/$uid/$LABEL" >/dev/null 2>&1
      rm -f "$PLIST"
      say "Schedule removed."
      return ;;
    daily|weekly|monthly) ;;
    *) die "schedule takes daily, weekly, monthly, off or nothing (status)" ;;
  esac

  [[ $at =~ ^([01]?[0-9]|2[0-3]):([0-5][0-9])$ ]] || die "time must be HH:MM"
  hour=$((10#${at%%:*})) minute=$((10#${at##*:}))
  interval="<key>Hour</key><integer>$hour</integer><key>Minute</key><integer>$minute</integer>"
  case $freq in
    weekly)  interval="<key>Weekday</key><integer>0</integer>$interval" ;;
    monthly) interval="<key>Day</key><integer>1</integer>$interval" ;;
  esac

  mkdir -p "${PLIST%/*}" "${LOGFILE%/*}"
  cat >"$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- schedule: $freq at $at -->
<plist version="1.0">
<dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>$(self_path)</string>
    <string>clean</string>
    <string>-y</string>
    <string>--notify</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>$interval</dict>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$HOME/.orbstack/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key><string>$LOGFILE</string>
  <key>StandardErrorPath</key><string>$LOGFILE</string>
  <key>LowPriorityIO</key><true/>
  <key>Nice</key><integer>10</integer>
</dict>
</plist>
EOF

  launchctl bootout "gui/$uid/$LABEL" >/dev/null 2>&1
  launchctl bootstrap "gui/$uid" "$PLIST" || die "launchctl couldn't load $PLIST"
  say "Scheduled: storage-rm clean ${B}$freq${N} at $at (log: ${LOGFILE/#$HOME/~})."
  say "Uses your config file for skips/options. Remove with: storage-rm schedule off"
}

# ---------- config + args ----------

load_config() {
  [[ -f $CONFIG ]] || return 0
  local line key val
  while IFS= read -r line || [[ -n $line ]]; do
    line=${line%%#*}
    [[ $line == *=* ]] || continue
    key=$(echo "${line%%=*}" | tr -d '[:space:]')
    val=${line#*=}; val=$(echo "$val" | sed -E 's/^[[:space:]]+|[[:space:]]+$//g; s/^["'\'']|["'\'']$//g')
    case $key in
      ONLY)        SELECTED=$val ;;
      SKIP)        SKIP=$val ;;
      DAYS)        if [[ $val =~ ^[0-9]+$ ]]; then DAYS=$val; else warn "config: DAYS must be a number"; fi ;;
      ROOTS)       ROOTS=$val ;;
      KEEP_GRADLE) if [[ $val =~ ^[0-9]+$ ]]; then KEEP_GRADLE=$val; else warn "config: KEEP_GRADLE must be a number"; fi ;;
      FORCE)       [[ $val == true ]] && FORCE=true ;;
      "")          ;;
      *)           warn "config: unknown key $key" ;;
    esac
  done <"$CONFIG"
}

load_config

ARGS=()
while (( $# )); do
  case $1 in
    scan|clean|list|big|schedule) CMD=$1 ;;
    -o|--only)   [[ $# -ge 2 ]] || die "$1 needs a value"; SELECTED=$2; shift ;;
    --only=*)    SELECTED=${1#*=} ;;
    -s|--skip)   [[ $# -ge 2 ]] || die "$1 needs a value"; SKIP=$2; shift ;;
    --skip=*)    SKIP=${1#*=} ;;
    -a|--all)    SELECTED=${ALL_CATS// /,} ;;
    -y|--yes)    ASSUME_YES=true ;;
    -n|--dry-run) DRY=true ;;
    -f|--force)  FORCE=true ;;
    --json)      JSON=true ;;
    --notify)    NOTIFY=true ;;
    --days)      [[ ${2:-} =~ ^[0-9]+$ ]] || die "--days needs a number"; DAYS=$2; shift ;;
    --roots)     [[ $# -ge 2 ]] || die "--roots needs a value"; ROOTS=$2; shift ;;
    --keep-gradle) [[ ${2:-} =~ ^[0-9]+$ ]] || die "--keep-gradle needs a number"; KEEP_GRADLE=$2; shift ;;
    -h|--help)   usage; exit 0 ;;
    -v|--version) echo "storage-rm $VERSION"; exit 0 ;;
    -*)          die "unknown option $1 (see --help)" ;;
    *)           ARGS+=("$1") ;;
  esac
  shift
done

for c in ${SELECTED//,/ } ${SKIP//,/ }; do
  valid_cat "$c" || die "unknown category '$c' (see: storage-rm list)"
done

[[ $(uname) == Darwin ]] || warn "storage-rm is built for macOS; some categories won't apply here"

case $CMD in
  scan)     cmd_scan ;;
  clean)    cmd_clean ;;
  list)     cmd_list ;;
  big)      cmd_big "${ARGS[0]:-25}" ;;
  schedule) cmd_schedule "${ARGS[0]:-status}" "${ARGS[1]:-10:00}" ;;
esac
